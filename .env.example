# Copy this file to .env and fill in the keys you want to use.
# Every value is optional - the app runs without them.
# Never commit your real .env file.

# Plain-language route and segment explanations (ai/llm/explainer.py).
# Without it the explainer returns rule-based text.
GROQ_API_KEY=

# Street-level imagery for the real-data feature builder
# (ingestion/fetch_all_features.py). Without it, visual features are simulated.
MAPILLARY_ACCESS_TOKEN=

# Address of the API for a production frontend build.
# During development the React dev server already proxies to http://localhost:8000.
REACT_APP_API_BASE_URL=
